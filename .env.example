# Postgres connection string (Neon via Vercel Marketplace sets DATABASE_URL automatically).
# Leave empty in local dev to use an embedded database stored in .pglite/
DATABASE_URL=

# Shared admin password (min 8 chars). Set in Vercel > Settings > Environment Variables,
# mark it "Sensitive", then redeploy to apply a change. Changing it signs everyone out.
ADMIN_PASSWORD=

# Optional alternative to ADMIN_PASSWORD: bcrypt hash. Generate with: npm run hash-password -- "password"
ADMIN_PASSWORD_HASH_B64=

# Random 32+ char string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
