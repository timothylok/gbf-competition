# Postgres connection string (Neon via Vercel Marketplace sets DATABASE_URL automatically).
# Leave empty in local dev to use an embedded database stored in .pglite/
DATABASE_URL=

# Generate with: npm run hash-password -- "your shared password"
ADMIN_PASSWORD_HASH_B64=

# Random 32+ char string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
